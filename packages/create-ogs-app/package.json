{
  "name": "create-ogs-app",
  "version": "0.1.0",
  "description": "Ship your OGS web game as its own iOS and Android app: `pnpm create ogs-app` makes an Expo app with the @open-game-system/shell plugin (casting, profiles, push links, native sign-in)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-ogs-app": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "template"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json",
    "lint": "biome lint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text-summary",
    "test:mutate": "stryker run"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@open-game-system/cast-kit-react": "workspace:*",
    "@open-game-system/notification-kit-server": "workspace:*",
    "@open-game-system/profile-kit": "workspace:*",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.0",
    "react": "^19.2.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
