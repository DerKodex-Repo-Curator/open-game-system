          {
            "backgroundColor": "#F2F2F4",
            "borderRadius": 10,
            "justifyContent": "center",
            "minHeight": 50,
            "paddingHorizontal": 16,
          }
        }
        testID="castPickerDevice-tv-1"
      >
        <Text
          style={
            {
              "color": "#111111",
              "fontSize": 17,
              "fontWeight": "600",
            }
          }
        >
          Living Room TV
        </Text>
      </View>
      <View
        style={
          {
            "gap": 10,
          }
        }
        testID="browserTv"
      >
        <Text
          style={
            {
              "color": "#111111",
              "fontSize": 18,
              "fontWeight": "700",
            }
          }
        >
          Use a browser TV
        </Text>
        <Text
          style={
            {
              "color": "#444444",
              "fontSize": 15,
              "lineHeight": 21,
            }
          }
        >
          On the TV (or a laptop plugged into it), open
           
          <Text
            style={
              {
                "color": "#111111",
                "fontWeight": "700",
              }
            }
            testID="browserTvAddress"
          >
            ogs-tv.pages.dev
          </Text>
           
          in the browser, then type the code it shows.
        </Text>
        <View
          style={
            {
              "alignItems": "center",
              "flexDirection": "row",
              "gap": 10,
            }
          }
        >
          <TextInput
            accessibilityLabel="Code on the TV"
            autoCapitalize="characters"
            autoCorrect={false}
            maxLength={8}
            onChangeText={[Function]}
            onSubmitEditing={[Function]}
            placeholder="Code"
            returnKeyType="go"
            style={
              {
                "borderColor": "#DADCE0",
                "borderRadius": 10,
                "borderWidth": 1,
                "color": "#111111",
                "flex": 1,
                "fontSize": 20,
                "letterSpacing": 4,
                "minHeight": 50,
                "paddingHorizontal": 12,
              }
            }
            testID="browserTvCode"
            value="ABC123"
          />
          <View
            accessibilityLabel="Pair"
            accessibilityRole="button"
            accessibilityState={
              {
                "busy": undefined,
                "checked": undefined,
                "disabled": false,
                "expanded": undefined,
                "selected": undefined,
              }
            }
            accessibilityValue={
              {
                "max": undefined,
                "min": undefined,
                "now": undefined,
                "text": undefined,
              }
            }
            accessible={true}
            collapsable={false}
            focusable={true}
            onBlur={[Function]}
            onClick={[Function]}
            onFocus={[Function]}
            onResponderGrant={[Function]}
            onResponderMove={[Function]}
            onResponderRelease={[Function]}
            onResponderTerminate={[Function]}
            onResponderTerminationRequest={[Function]}
            onStartShouldSetResponder={[Function]}
            style={
              [
                {
                  "alignItems": "center",
                  "backgroundColor": "#111111",
                  "borderRadius": 10,
                  "justifyContent": "center",
                  "minHeight": 50,
                  "minWidth": 88,
                  "paddingHorizontal": 16,
                },
                false,
              ]
            }
            testID="browserTvPair"
          >
            <Text
              style={
                {
                  "color": "#FFFFFF",
                  "fontSize": 17,
                  "fontWeight": "600",
                }
              }
            >
              Pair
            </Text>
          </View>
        </View>
      </View>
      <View
        accessibilityRole="button"
        accessibilityState={
          {
            "busy": undefined,
            "checked": undefined,
            "disabled": undefined,
            "expanded": undefined,
            "selected": undefined,
          }
        }
        accessibilityValue={
          {
            "max": undefined,
            "min": undefined,
            "now": undefined,
            "text": undefined,
          }
        }
        accessible={true}
        collapsable={false}
        focusable={true}
        onBlur={[Function]}
        onClick={[Function]}
        onFocus={[Function]}
        onResponderGrant={[Function]}
        onResponderMove={[Function]}
        onResponderRelease={[Function]}
        onResponderTerminate={[Function]}
        onResponderTerminationRequest={[Function]}
        onStartShouldSetResponder={[Function]}
        style={
          {
            "alignItems": "center",
            "justifyContent": "center",
            "minHeight": 44,
          }
        }
        testID="castPickerClose"
      >
        <Text
          style={
            {
              "color": "#555555",
              "fontSize": 16,
              "fontWeight": "500",
            }
          }
        >
