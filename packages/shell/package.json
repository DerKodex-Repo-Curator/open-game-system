{
  "name": "@open-game-system/shell",
  "version": "0.0.0",
  "description": "The OGS native shell: ship an OGS web game as its own iOS/Android app with OGS casting, profiles, push and links (Expo config plugin + React Native runtime)",
  "license": "MIT",
  "main": "build/index.js",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    "./app.plugin.js": "./app.plugin.js",
    "./plugin": {
      "types": "./plugin/build/index.d.ts",
      "default": "./plugin/build/index.js"
    },
    ".": {
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./modules/*": {
      "react-native": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./build/*.js"
    }
  },
  "files": [
    "app.plugin.js",
    "build",
    "plugin/build",
    "src",
    "!src/**/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p plugin/tsconfig.json",
    "clean": "rm -rf build plugin/build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p plugin/tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests && jest --ci --passWithNoTests",
    "test:plugin": "vitest run --passWithNoTests",
    "test:runtime": "jest --ci --passWithNoTests"
  },
  "dependencies": {
    "@open-game-system/app-bridge-native": "workspace:*",
    "@open-game-system/app-bridge-types": "workspace:*",
    "@open-game-system/ogs-protocol": "workspace:*",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~55.0.31",
    "expo-apple-authentication": "~55.0.0",
    "expo-constants": "~55.0.17",
    "expo-device": "^55.0.21",
    "expo-haptics": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-notifications": "^55.0.27",
    "expo-secure-store": "^55.0.18",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-google-cast": "^4.9.1",
    "react-native-webview": "13.16.0"
  },
  "peerDependenciesMeta": {
    "expo-apple-authentication": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@expo/dom-webview": "^55.0.6",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "expo": "~55.0.31",
    "expo-constants": "~55.0.17",
    "expo-device": "^55.0.21",
    "expo-haptics": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-notifications": "^55.0.27",
    "expo-secure-store": "^55.0.18",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.22",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-google-cast": "^4.9.1",
    "react-native-webview": "13.16.0",
    "react-test-renderer": "19.2.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
