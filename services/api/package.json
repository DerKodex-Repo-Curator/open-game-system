{
  "name": "@open-game-system/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text-summary",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "test:mutate": "stryker run",
    "db:migrate": "wrangler d1 execute opengame-api-db --file=schema.sql",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 execute opengame-api-db --local --file=schema.sql",
    "dev:local": "wrangler dev",
    "emulate": "node scripts/emulate.mjs",
    "game-key": "node scripts/game-key.mjs",
    "issue-key": "node scripts/issue-key.mjs",
    "stream:ready": "node scripts/stream-ready.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@open-game-system/ogs-protocol": "workspace:*",
    "hono": "^4.12.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@open-game-system/profile-kit": "workspace:*",
    "@open-game-system/shell": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.1.0",
    "emulate": "0.12.1",
    "http_ece": "1.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  }
}
