{
  "name": "@open-game-system/tv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OGS TV launcher: the page the Chromecast stream shows for the whole cast; frames each game's TV page",
  "scripts": {
    "dev": "vite --host --port 5180 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5180 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text-summary",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "deploy": "vite build && CLOUDFLARE_ACCOUNT_ID=ccf4d9a0a3b76ffae0b6ee048de66f07 wrangler pages deploy dist --project-name ogs-tv --branch main"
  },
  "dependencies": {
    "@open-game-system/ogs-protocol": "workspace:*",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^28.1.0",
    "jsqr": "^1.4.0",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.0"
  }
}
