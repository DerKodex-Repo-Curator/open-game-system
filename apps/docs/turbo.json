{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/specification.md",
        "$TURBO_ROOT$/packages/profile-kit/src/**",
        "$TURBO_ROOT$/packages/ogs-protocol/src/**",
        "$TURBO_ROOT$/templates/ogs-starter/**",
        "!$TURBO_ROOT$/templates/ogs-starter/node_modules/**",
        "!$TURBO_ROOT$/templates/ogs-starter/dist/**",
        "$TURBO_ROOT$/packages/cast-kit-core/src/**",
        "$TURBO_ROOT$/packages/cast-kit-react/src/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/specification.md",
        "$TURBO_ROOT$/packages/profile-kit/src/**",
        "$TURBO_ROOT$/packages/ogs-protocol/src/**",
        "$TURBO_ROOT$/templates/ogs-starter/**",
        "!$TURBO_ROOT$/templates/ogs-starter/node_modules/**",
        "!$TURBO_ROOT$/templates/ogs-starter/dist/**",
        "$TURBO_ROOT$/packages/cast-kit-core/src/**",
        "$TURBO_ROOT$/packages/cast-kit-react/src/**"
      ]
    }
  }
}
