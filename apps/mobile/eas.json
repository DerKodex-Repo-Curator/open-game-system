{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "development:simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium",
        "cache": {
          "key": "preview-ios-{{allShas}}"
        }
      },
      "android": {
        "buildType": "apk",
        "cache": {
          "key": "preview-android-{{allShas}}"
        }
      },
      "env": {
        "EXPO_PUBLIC_OGS_API": "https://opengame-api.jonathanrmumm.workers.dev",
        "EXPO_PUBLIC_OGS_TV": "https://ogs-tv.pages.dev"
      }
    },
    "production": {
      "ios": {
        "simulator": false
      }
    },
    "beta": {
      "distribution": "store",
      "channel": "beta",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_OGS_API": "https://opengame-api.jonathanrmumm.workers.dev",
        "EXPO_PUBLIC_OGS_TV": "https://ogs-tv.pages.dev"
      }
    }
  },
  "submit": {
    "production": {},
    "beta": {}
  }
}
